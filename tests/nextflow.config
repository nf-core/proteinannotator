/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/proteinannotator/'
    outdir                       = './results'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

process {
    withName: NCBIREFSEQDOWNLOAD {
        cpus   = 1
        memory = 4.GB
    }
    withName: DIAMONDPREPARETAXA {
        cpus   = 1
        memory = 4.GB
    }
    withName: DIAMOND_MAKEDB {
        cpus   = 1
        memory = 4.GB
    }
    withName: DIAMOND_BLASTP {
        cpus   = 1
        memory = 4.GB
    }
}
